{
  "name": "gluten-free-supermarkets",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "build:android:windows": "python scripts/build-android-windows.py",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:rules": "firebase emulators:exec --only firestore --project demo-sin-gluten \"jest --config jest.rules.config.cjs --runInBand\"",
    "test:e2e": "playwright test",
    "typecheck": "expo customize tsconfig.json && node node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "eslint app src tests plugins scripts *.js *.cjs *.ts",
    "lint:server": "eslint functions/src",
    "format": "prettier --write app src tests functions/src scripts plugins *.js *.cjs *.ts *.json .github",
    "test:cloud": "node scripts/run-cloud-tests.mjs",
    "firebase:verify": "node scripts/verify-firebase.mjs",
    "secrets:check": "python scripts/scan-secrets.py",
    "audit:security": "node scripts/check-audit.mjs",
    "audit:release": "node scripts/check-audit.mjs --release",
    "check": "npm run typecheck && npm run lint && npm test && expo install --check",
    "export:web": "expo export --platform web && node scripts/generate-service-worker.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.21",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.13",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "firebase": "^13.1.0",
    "idb": "^8.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/compat": "^2.1.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript/native": "npm:typescript@~7.0.2",
    "eslint": "^10.13.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-import-resolver-typescript": "^3.10.1",
    "firebase-tools": "^15.34.1",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.13",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "gaxios": {
      "uuid": "^11.1.1"
    }
  },
  "private": true,
  "engines": {
    "node": ">=24.3.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.13.0"
}
