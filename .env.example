# Public client configuration. Never put server/admin secrets here.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_OFF_ENV=production
# Current product decision: local app, no paid backend. Keep cloud disabled.
# Enabling a future cloud deployment requires a separate scope/cost decision.
EXPO_PUBLIC_CLOUD_ENABLED=false
EXPO_PUBLIC_PROJECT_ID=
EXPO_PUBLIC_API_KEY=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Optional local emulators (Firebase demo project only).
EXPO_PUBLIC_USE_EMULATORS=false
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1
# Optional technical telemetry endpoint. No events sent when empty.
EXPO_PUBLIC_TELEMETRY_URL=
