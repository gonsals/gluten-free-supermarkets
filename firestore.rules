rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid && !exists(/databases/$(database)/documents/_accountState/$(uid)); }
    function boundedList() { return request.query.limit != null && request.query.limit <= 100; }
    function moderator() { return request.auth != null && request.auth.token.get('admin', false) == true; }
    function validFavorite(barcode) {
      let d = request.resource.data;
      return d.keys().hasOnly(['barcode','name','brands','updatedAt','deleted','snapshot','receivedAt'])
        && d.keys().hasAll(['barcode','name','brands','updatedAt','deleted','snapshot','receivedAt'])
        && barcode.matches('^[0-9]{8}$|^[0-9]{12,14}$') && d.barcode == barcode
        && d.name is string && d.name.size() <= 300 && d.brands is string && d.brands.size() <= 500
        && d.updatedAt is int && d.updatedAt >= 0 && d.updatedAt <= request.time.toMillis() + 300000
        && d.deleted is bool && d.snapshot is string && d.snapshot.size() <= 50000
        && (d.deleted || d.snapshot.size() > 0) && d.receivedAt == request.time;
    }
    match /users/{uid}/favorites/{barcode} {
      allow get: if owner(uid);
      allow list: if owner(uid) && boundedList();
      allow create: if owner(uid) && validFavorite(barcode);
      allow update: if owner(uid) && validFavorite(barcode) && request.resource.data.updatedAt >= resource.data.updatedAt;
      allow delete: if owner(uid);
    }
    match /priceObservations/{id} {
      allow get: if moderator() || (request.auth != null && resource.data.authorId == request.auth.uid);
      allow list: if boundedList() && (moderator() || (request.auth != null && resource.data.authorId == request.auth.uid));
      // All validation, rate limits and moderation go through callable functions.
      allow write: if false;
    }
    match /publishedPrices/{id} { allow get: if true; allow list: if boundedList(); allow write: if false; }
    match /products/{barcode} { allow get: if true; allow list: if boundedList(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
