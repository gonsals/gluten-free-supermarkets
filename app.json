{
  "expo": {
    "name": "SinGluten",
    "slug": "gluten-free-supermarkets",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "singluten",

    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tumarre.singluten"
    },
    "android": {
      "package": "com.tumarre.singluten",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FCF8F0"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withWindowsCmake",
      "./plugins/withAndroidBuildInputs",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 96,
          "backgroundColor": "#FCF8F0",
          "dark": { "image": "./assets/images/splash.png", "backgroundColor": "#251E1A" }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SinGluten necesita la cámara para leer el código de barras del alimento. También puedes introducirlo manualmente.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
